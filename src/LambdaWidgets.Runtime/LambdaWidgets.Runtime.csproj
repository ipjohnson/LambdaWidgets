<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <IsPackable>true</IsPackable>
        <PackageId>LambdaWidgets.Runtime</PackageId>
        <Description>The widget host for a Hardened application: routing and binding from the widget event, Razor helpers that emit cwdb-action from generated links, describe, and the typed widget context.</Description>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <!--
      Exactly the set a [LambdaWebModule] application carries, with the Amz web generator swapped
      out. A widget application is web-shaped on a third host, so the generated Routes and Links
      types, the template bases, validation and the route table are all available unchanged.
    -->
    <!--
      The generators that run over this assembly's own code. [LambdaWidgetModule] is a
      [DependencyModule], and its two halves come from two packages: DependencyModules.SourceGenerator
      emits the LambdaWidgetModuleAttribute an application applies, and Hardened.Library.SourceGenerator
      emits PopulateServiceCollection. Both are developmentDependency, so neither flows to a
      consumer of this package.

      With only the Hardened one the module compiles and the attribute does not exist, which reads
      as CS0616 "not an attribute class" at the application rather than as a missing reference here.
      Day-one check 7.
    -->
    <ItemGroup>
        <PackageReference Include="DependencyModules.SourceGenerator" />
        <PackageReference Include="Hardened.Library.SourceGenerator" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Amazon.Lambda.Core" />
        <PackageReference Include="DependencyModules.Runtime" />
        <PackageReference Include="Hardened.Aws.Lambda.Runtime" />
        <PackageReference Include="Hardened.Requests.Abstract" />
        <PackageReference Include="Hardened.Requests.Runtime" />
        <PackageReference Include="Hardened.Shared.Runtime" />
        <PackageReference Include="Hardened.Templates.RazorBlade" />
        <!--
          Not PrivateAssets, matching Hardened.Templates.RazorBlade. RazorBlade's analyzer has to
          run in the consuming application's compilation to turn its .cshtml into classes, so the
          reference has to reach it. An application still references RazorBlade directly as well,
          because RazorBlade ships no buildTransitive and its .props never arrives otherwise.
        -->
        <PackageReference Include="RazorBlade" />
        <PackageReference Include="Hardened.Web.Runtime" />
        <PackageReference Include="Microsoft.Extensions.Primitives" />
        <PackageReference Include="System.Text.Json" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="LambdaWidgets.Runtime.Tests" />
    </ItemGroup>

</Project>
