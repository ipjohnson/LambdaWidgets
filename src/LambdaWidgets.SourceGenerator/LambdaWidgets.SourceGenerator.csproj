<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <!-- Matches Hardened.Amz.Web.Lambda.SourceGenerator, which compiles the same source in. -->
        <LangVersion>10</LangVersion>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsPackable>true</IsPackable>
        <PackageId>LambdaWidgets.SourceGenerator</PackageId>
        <Description>Emits the entry point for a [LambdaWidgetModule] application: Main, the RuntimeSupport bootstrap, and the Invoke the test driver calls.</Description>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <!-- Build-only: consumers must not inherit it as a runtime dependency. -->
        <DevelopmentDependency>true</DevelopmentDependency>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Microsoft.Extensions.Primitives" />
        <PackageReference Include="System.Memory" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!--
      Three packages ship source rather than an assembly, because an analyzer is loaded by the
      compiler with no probing path of its own and a sibling DLL is a FileNotFoundException at
      initialization. Each is compiled into this assembly, and each needs an opt-in property to do
      it: PrivateAssets=all means no package can flow the switch to the project that consumes it.

      This is the arrangement Hardened.Amz.Web.Lambda.SourceGenerator uses. Getting it wrong shows
      up as compile errors inside somebody else's source under ~/.nuget/packages, naming APIs the
      reader never wrote.
    -->
    <PropertyGroup>
        <PackageCSharpAuthorIncludeSource>true</PackageCSharpAuthorIncludeSource>

        <!-- CSharpAuthor's opt-in Roslyn root: ValidationModules' emitters bridge ITypeSymbol to
             ITypeDefinition through it, so their sources do not resolve without it. -->
        <PackageCSharpAuthorIncludeRoslyn>true</PackageCSharpAuthorIncludeRoslyn>

        <PackageHardenedIncludeSource>true</PackageHardenedIncludeSource>

        <!-- Hardened.SourceGenerator's validation files build ValidatedTypeModel and emit
             validators against ValidationModules' generator internals, which have to be compiled
             in here too or those files do not resolve. -->
        <PackageValidationModulesIncludeSource>true</PackageValidationModulesIncludeSource>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CSharpAuthor">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>build</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Hardened.SourceGenerator">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>build</IncludeAssets>
        </PackageReference>
        <PackageReference Include="ValidationModules.SourceGenerator.Impl">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>build</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>

</Project>
