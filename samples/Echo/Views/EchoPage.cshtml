@inherits Echo.EchoAppWidgetTemplates<Echo.EchoPage>
@Html.Raw(Model.Echo)
<h3>widgetContext</h3>
<pre>dashboard   @Model.Context.DashboardName
widget      @Model.Context.WidgetId
account     @Model.Context.AccountId
theme       @Model.Context.Theme
period      @Model.Context.Period.Seconds s@(Model.Context.Period.IsAutomatic ? " (auto)" : "")
time range  @Model.Context.TimeRange.Effective.Start.ToString("u") to @Model.Context.TimeRange.Effective.End.ToString("u")
size        @Model.Context.Width x @Model.Context.Height
invoked as  @Model.Context.InvokedFunctionArn</pre>
