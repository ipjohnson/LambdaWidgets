@inherits LambdaWidgets.Runtime.Tests.WidgetTestAppWidgetTemplates<LambdaWidgets.Runtime.Tests.Results>
@Widget.Root()
<h1>@Model.Title</h1>
<form>
  <input name="query" value="@Model.Query">
</form>
@Widget.Button("Run query", "/search", primary: true)
@Widget.Link("Next", "/search", ("cursor", Model.Cursor))
@Widget.Confirm("Reset", "Discard the edited query?", "/search", false, ("reset", "true"))
<a>What does this do?</a>
@Widget.Popup("<b>It searches logs.</b>")
@Widget.EndRoot()
