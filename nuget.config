<?xml version="1.0" encoding="utf-8"?>
<!--
    nuget.org only, and every Hardened package is restored from it.

    A ProjectReference to a sibling Hardened checkout would hide the packaging defects this
    repository exists to find, so there is no local feed to fall back to either. If a package
    is missing from nuget.org the restore must fail and the gap goes in FINDINGS.md.
-->
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
</configuration>
