@inherits WidgetName.WidgetNameAppWidgetTemplates<WidgetName.SearchPage>
@Widget.Root()
<form>
  <label>Log groups</label>
  <input name="logGroups" value="@Model.LogGroups" size="60">
  <label>Query</label>
  <textarea name="query" rows="4">@Model.Query</textarea>
</form>
@* Every route comes from the generated Links. Rename Search in WidgetNameApp.cs and this line
   fails to compile, rather than rendering a button that does nothing. *@
@Widget.Button("Run query", Links.Pages.Search(), primary: true)
@Widget.Confirm("Reset", "Discard the edited query?", Links.Pages.Reset())
<p>Searching @Model.Context.TimeRange.Effective.Start.ToString("u") to @Model.Context.TimeRange.Effective.End.ToString("u")</p>
@Widget.EndRoot()
