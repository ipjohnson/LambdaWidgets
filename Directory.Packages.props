<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <!--
      One line, 0.30.0-rc1000.

      Hardened.Amz is gone. Framework PR #305 consolidated four repositories into
      Hardened.Framework and rebuilt the AWS packages on a new host seam, so there is no second
      line to keep in step and no pin to hold back. The Amz packages stay on nuget.org at
      0.22.0-rc1000, frozen; nothing here takes one.

      Nothing here floats. Central package management rejects floating versions by default
      (NU1011) and that default is left in place.
    -->
    <ItemGroup Label="Hardened.Framework">
        <PackageVersion Include="Hardened.Library.SourceGenerator" Version="0.30.0-rc1000" />
        <PackageVersion Include="Hardened.Requests.Abstract" Version="0.30.0-rc1000" />
        <PackageVersion Include="Hardened.Requests.Runtime" Version="0.30.0-rc1000" />
        <PackageVersion Include="Hardened.Requests.Testing" Version="0.30.0-rc1000" />
        <PackageVersion Include="Hardened.Shared.Runtime" Version="0.30.0-rc1000" />
        <PackageVersion Include="Hardened.Shared.Testing" Version="0.30.0-rc1000" />
        <PackageVersion Include="Hardened.Shared.Testing.xUnit" Version="0.30.0-rc1000" />
        <PackageVersion Include="Hardened.Templates.RazorBlade" Version="0.30.0-rc1000" />
        <PackageVersion Include="Hardened.Web.Kestrel.Runtime" Version="0.30.0-rc1000" />
        <PackageVersion Include="Hardened.Web.Runtime" Version="0.30.0-rc1000" />
        <PackageVersion Include="Hardened.Web.SourceGenerator" Version="0.30.0-rc1000" />
        <PackageVersion Include="Hardened.Web.StaticContent" Version="0.30.0-rc1000" />
        <PackageVersion Include="Hardened.Web.Testing" Version="0.30.0-rc1000" />
    </ItemGroup>

    <!--
      The Lambda host and the adapter seam a widget plugs into. LambdaWidgets.Runtime ships an
      IPayloadAdapter and the module that registers it; the host owns the invocation loop and
      brings the request pipeline with it.

      No adapter package from the framework. Hardened.Aws.Lambda.ApiGateway and the rest each serve
      a trigger this repository does not have, and the Hardened.Aws.Lambda meta package would put
      every Amazon event assembly in a widget's deployment bundle to reach none of them.

      Hardened.Aws.DynamoDbClient and .Testing arrive on the next line, restored from the Amz
      history by Framework #307. The Dynamo sample is item 6, so nothing is pinned for them until a
      project references one.
    -->
    <ItemGroup Label="Hardened.Aws">
        <PackageVersion Include="Hardened.Aws.Lambda.Runtime" Version="0.30.0-rc1000" />
        <PackageVersion Include="Hardened.Aws.Lambda.Testing" Version="0.30.0-rc1000" />
    </ItemGroup>

    <!--
      DependencyModules is where [DependencyModule] and the generated PopulateServiceCollection
      come from, and Hardened's module system is built on it.

      Hardened.DependencyModules.SourceGenerator is not referenced and must not be. It is not
      packable on the 0.30 line: it reaches a consumer inside Hardened.Library.SourceGenerator,
      which packs its DLL into its own analyzers/dotnet/cs. The 0.1.0-rc1 still on nuget.org is
      four release lines behind and is not the same generator.
    -->
    <ItemGroup Label="Code generation">
        <PackageVersion Include="DependencyModules.Runtime" Version="1.3.1" />
        <PackageVersion Include="DependencyModules.SourceGenerator" Version="1.3.1" />
    </ItemGroup>

    <!--
      Both publish AOT with zero trim and AOT warnings, checked against the jobs the interpreter
      actually does rather than by linking them. See FINDINGS.md day-one check 5.
    -->
    <ItemGroup Label="Parsing">
        <PackageVersion Include="AngleSharp" Version="1.8.0" />
        <PackageVersion Include="Markdig" Version="1.3.2" />
    </ItemGroup>

    <ItemGroup Label="Templates">
        <PackageVersion Include="RazorBlade" Version="1.0.0" />
    </ItemGroup>

    <!--
      The 3.7 line, pinned. Day-one check 1 published all three under PublishAot with no trim or
      AOT warning at all, so 4.x is not needed. Pinned rather than floating so the same commit
      resolves the same SDK on a rebuild.

      Amazon.Lambda.Core is here because the adapter takes an ILambdaContext. RuntimeSupport is
      not: HardenedLambdaBootstrap owns the invocation loop and brings it. A serializer package is
      not needed at all now that an adapter binds its own payload.
    -->
    <ItemGroup Label="AWS">
        <PackageVersion Include="Amazon.Lambda.Core" Version="3.3.0" />
        <PackageVersion Include="Amazon.CDK.Lib" Version="2.263.0" />
        <PackageVersion Include="AWSSDK.CloudWatchLogs" Version="3.7.509.3" />
        <PackageVersion Include="AWSSDK.DynamoDBv2" Version="3.7.513.4" />
        <PackageVersion Include="AWSSDK.Lambda" Version="3.7.511.24" />
    </ItemGroup>

    <ItemGroup Label="Microsoft.Extensions and BCL">
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="8.0.1" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
        <PackageVersion Include="Microsoft.Extensions.Primitives" Version="8.0.0" />
        <PackageVersion Include="System.Text.Json" Version="8.0.5" />
    </ItemGroup>

    <!--
      xunit.v3, never xunit 2.x. Hardened.Shared.Testing depends on DependencyModules.xUnit, which
      brings v3, and referencing 2.x alongside it makes every Fact and Assert ambiguous.
    -->
    <ItemGroup Label="Testing">
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageVersion Include="NSubstitute" Version="5.1.0" />
        <PackageVersion Include="SimpleFixture.NSubstitute" Version="4.0.0-RC191" />
        <PackageVersion Include="SimpleFixture.xUnit" Version="4.0.0-RC191" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageVersion Include="xunit.v3" Version="3.2.2" />
        <PackageVersion Include="xunit.v3.assert" Version="3.2.2" />
    </ItemGroup>

</Project>
