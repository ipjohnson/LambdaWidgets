<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <!--
      Hardened and Hardened.Amz move together at 0.21.0-rc1000, the last line both released.

      Hardened.Framework is on 0.22.0-rc1000; Hardened.Amz is not. Amz main has merged the
      Framework 0.22.0 uptake (#90) and the generated-Main test tool start (#89), but nothing is
      on nuget.org past 0.21.0-rc1000, so taking the newer framework would pair Amz assemblies
      with a framework they were never compiled against. Bump both together when Amz 0.22.0-rc1000
      ships. See FINDINGS.md F-02.

      Nothing here floats. Central package management rejects floating versions by default
      (NU1011) and that default is left in place.
    -->
    <ItemGroup Label="Hardened.Framework">
        <PackageVersion Include="Hardened.Library.SourceGenerator" Version="0.21.0-rc1000" />
        <PackageVersion Include="Hardened.Requests.Abstract" Version="0.21.0-rc1000" />
        <PackageVersion Include="Hardened.Requests.Runtime" Version="0.21.0-rc1000" />
        <PackageVersion Include="Hardened.Shared.Runtime" Version="0.21.0-rc1000" />
        <PackageVersion Include="Hardened.Shared.Testing" Version="0.21.0-rc1000" />
        <PackageVersion Include="Hardened.Shared.Testing.xUnit" Version="0.21.0-rc1000" />
        <PackageVersion Include="Hardened.SourceGenerator" Version="0.21.0-rc1000" />
        <PackageVersion Include="Hardened.Templates.RazorBlade" Version="0.21.0-rc1000" />
        <PackageVersion Include="Hardened.Web.Kestrel.Runtime" Version="0.21.0-rc1000" />
        <PackageVersion Include="Hardened.Web.Runtime" Version="0.21.0-rc1000" />
        <PackageVersion Include="Hardened.Web.SourceGenerator" Version="0.21.0-rc1000" />
        <PackageVersion Include="Hardened.Web.StaticContent" Version="0.21.0-rc1000" />
        <PackageVersion Include="Hardened.Web.Testing" Version="0.21.0-rc1000" />
    </ItemGroup>

    <ItemGroup Label="Hardened.Amz">
        <PackageVersion Include="Hardened.Amz.Cdk" Version="0.21.0-rc1000" />
        <PackageVersion Include="Hardened.Amz.DynamoDbClient" Version="0.21.0-rc1000" />
        <PackageVersion Include="Hardened.Amz.Shared.Lambda.Runtime" Version="0.21.0-rc1000" />
        <PackageVersion Include="Hardened.Amz.Shared.Lambda.Testing" Version="0.21.0-rc1000" />
    </ItemGroup>

    <!--
      CSharpAuthor must be exactly what Hardened.Framework builds its generators against.

      Hardened.SourceGenerator ships as source and is compiled into LambdaWidgets.SourceGenerator,
      so its use of CSharpAuthor is compiled here too, and PrivateAssets=all on the framework side
      means no dependency constraint arrives to say which version. The package's own HARDENED001
      guard demands 2.0.0 or later but skips any prerelease pin - and 2.0.0 final does not exist,
      so the guard cannot check the only version that works. See FINDINGS.md F-01.

      ValidationModules.SourceGenerator.Impl moves with it: its emitters need CSharpAuthor 2.0's
      Roslyn bridge, which the generator project opts into.
    -->
    <ItemGroup Label="Code generation">
        <PackageVersion Include="CSharpAuthor" Version="2.0.0-preview1005" />
        <PackageVersion Include="DependencyModules.Runtime" Version="1.3.1" />
        <PackageVersion Include="DependencyModules.SourceGenerator" Version="1.3.1" />
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0" />
        <PackageVersion Include="ValidationModules.SourceGenerator.Impl" Version="1.0.0" />
    </ItemGroup>

    <!--
      Both publish AOT with zero trim and AOT warnings, checked against the jobs the interpreter
      actually does rather than by linking them. See FINDINGS.md day-one check 5.
    -->
    <ItemGroup Label="Parsing">
        <PackageVersion Include="AngleSharp" Version="1.8.0" />
        <PackageVersion Include="Markdig" Version="1.3.2" />
    </ItemGroup>

    <ItemGroup Label="Templates">
        <PackageVersion Include="RazorBlade" Version="1.0.0" />
    </ItemGroup>

    <!--
      The 3.7 line, pinned, matching the AWSSDK.DynamoDBv2 that Hardened.Amz pins. Day-one check 1
      publishes these under PublishAot and records the warnings; 4.x is the fallback if 3.7 warns.
      Pinned rather than floating so the same commit resolves the same SDK on a rebuild.
    -->
    <ItemGroup Label="AWS">
        <PackageVersion Include="Amazon.Lambda.Core" Version="3.3.0" />
        <PackageVersion Include="Amazon.Lambda.RuntimeSupport" Version="2.2.0" />
        <PackageVersion Include="Amazon.Lambda.Serialization.SystemTextJson" Version="2.4.3" />
        <PackageVersion Include="Amazon.CDK.Lib" Version="2.263.0" />
        <PackageVersion Include="AWSSDK.CloudWatchLogs" Version="3.7.509.3" />
        <PackageVersion Include="AWSSDK.DynamoDBv2" Version="3.7.513.4" />
        <PackageVersion Include="AWSSDK.Lambda" Version="3.7.511.24" />
    </ItemGroup>

    <ItemGroup Label="Microsoft.Extensions and BCL">
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="8.0.1" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
        <PackageVersion Include="Microsoft.Extensions.Primitives" Version="8.0.0" />
        <PackageVersion Include="System.Memory" Version="4.5.5" />
        <PackageVersion Include="System.Text.Json" Version="8.0.5" />
    </ItemGroup>

    <!--
      xunit.v3, never xunit 2.x. Hardened.Shared.Testing depends on DependencyModules.xUnit, which
      brings v3, and referencing 2.x alongside it makes every Fact and Assert ambiguous.
    -->
    <ItemGroup Label="Testing">
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageVersion Include="NSubstitute" Version="5.1.0" />
        <PackageVersion Include="SimpleFixture.NSubstitute" Version="4.0.0-RC191" />
        <PackageVersion Include="SimpleFixture.xUnit" Version="4.0.0-RC191" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageVersion Include="xunit.v3" Version="3.2.2" />
        <PackageVersion Include="xunit.v3.assert" Version="3.2.2" />
    </ItemGroup>

</Project>
